&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2021-06-28_00:00:00','2021-06-28_00:00:00', '2021-06-28_00:00:00',
 end_date   = '2021-06-29_12:00:00','2021-06-29_12:00:00', '2021-06-29_12:00:00',
 interval_seconds = 21600
/

&ungrib
 out_format = 'WPS',
 prefix = 'SFC_FILE',
 !prefix = 'UP_FILE',
/

&geogrid
 parent_id         =   1,   1,  1,
 parent_grid_ratio =   1,   3,  3,
 i_parent_start    =   1,  175, 125,
 j_parent_start    =   1,  160, 138,
 e_we              =  700, 124, 142,
 e_sn              =  600, 106, 139
 !geog_data_res = 'gtopo_2m','default','default'
 geog_data_res = 'default','default','default'
 dx = 1000,
 dy = 1000,
 map_proj = 'lambert',
 ref_lat   =  46.0,
 ref_lon   =  6.5,
 truelat1  =  30.0,
 truelat2  =  60.0,
 stand_lon =  7,
 geog_data_path = '/data/jtrapp/a/jamessg3/WRF_HELP/WRF_GEOG/WPS_GEOG'
 !geog_data_path = '/data/jtrapp/a/jtrapp/geog2/'
/

&metgrid
 fg_name = 'UP_FILE','SFC_FILE','PRES'
 io_form_metgrid=2,
/
